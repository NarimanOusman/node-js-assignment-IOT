# Server - MongoDB Connection (Required for both local and production)
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/database

# Client - API Base URL
# Local: http://localhost:3000 (if server runs separately)
# Production (Vercel): https://your-vercel-domain.vercel.app/api (same domain, /api prefix)
VITE_API_URL=http://localhost:3000
